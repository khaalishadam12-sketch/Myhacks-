-- [[ ADAM HUB V2 - MOBILE OPTIMIZED ]] --
local Player = game.Players.LocalPlayer
local CoreGui = game:GetService("CoreGui")

-- Setting Default
_G.AuraEnabled = false
local Range = 18
local KillDelay = 0.15

-- 1. SETUP UI
local ScreenGui = Instance.new("ScreenGui", CoreGui)
ScreenGui.Name = "AdamHubMobile"

-- Frame Utama
local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.Size = UDim2.new(0, 180, 0, 150)
MainFrame.Position = UDim2.new(0.5, -90, 0.4, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true -- Boleh tarik guna jari

local Corner = Instance.new("UICorner", MainFrame)
Corner.CornerRadius = URadius.new(0, 12)

-- Tajuk Menu
local Title = Instance.new("TextLabel", MainFrame)
Title.Size = UDim2.new(1, 0, 0, 35)
Title.Text = "ADAM HUB V2"
Title.TextColor3 = Color3.new(1, 1, 1)
Title.BackgroundTransparency = 1
Title.Font = Enum.Font.GothamBold
Title.TextSize = 14

-- Butang Kill Aura
local AuraBtn = Instance.new("TextButton", MainFrame)
AuraBtn.Size = UDim2.new(0, 160, 0, 45)
AuraBtn.Position = UDim2.new(0, 10, 0, 45)
AuraBtn.Text = "Kill Aura: OFF"
AuraBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
AuraBtn.TextColor3 = Color3.new(1, 1, 1)
AuraBtn.Font = Enum.Font.GothamSemibold
AuraBtn.TextSize = 14
Instance.new("UICorner", AuraBtn)

-- Butang Tutup (Minimize)
local CloseBtn = Instance.new("TextButton", MainFrame)
CloseBtn.Size = UDim2.new(0, 160, 0, 35)
CloseBtn.Position = UDim2.new(0, 10, 0, 100)
CloseBtn.Text = "Kecilkan Menu"
CloseBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
CloseBtn.TextColor3 = Color3.new(0.8, 0.8, 0.8)
CloseBtn.Font = Enum.Font.Gotham
CloseBtn.TextSize = 12
Instance.new("UICorner", CloseBtn)

-- Butang "BUKA" (Floating Button)
local OpenBtn = Instance.new("TextButton", ScreenGui)
OpenBtn.Size = UDim2.new(0, 60, 0, 30)
OpenBtn.Position = UDim2.new(0, 5, 0.5, 0)
OpenBtn.Text = "BUKA"
OpenBtn.Visible = false
OpenBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
OpenBtn.TextColor3 = Color3.new(1, 1, 1)
OpenBtn.Draggable = true
Instance.new("UICorner", OpenBtn)

-- 2. LOGIK BUTANG UI
AuraBtn.MouseButton1Click:Connect(function()
    _G.AuraEnabled = not _G.AuraEnabled
    if _G.AuraEnabled then
        AuraBtn.Text = "Kill Aura: ON"
        AuraBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
    else
        AuraBtn.Text = "Kill Aura: OFF"
        AuraBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
    end
end)

CloseBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = false
    OpenBtn.Visible = true
end)

OpenBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = true
    OpenBtn.Visible = false
end)

-- 3. LOGIK KILL AURA (LOOP)
task.spawn(function()
    while task.wait(KillDelay) do
        if _G.AuraEnabled then
            pcall(function()
                local Char = Player.Character
                local Tool = Char and Char:FindFirstChildOfClass("Tool")
                
                if Tool and Char:FindFirstChild("HumanoidRootPart") then
                    -- Cari bahagian pedang (Mana-mana Part yang ada dalam Tool)
                    local WeaponPart = Tool:FindFirstChild("Handle") or Tool:FindFirstChildOfClass("Part") or Tool:FindFirstChildOfClass("MeshPart")
                    
                    if WeaponPart then
                        for _, v in pairs(game.Players:GetPlayers()) do
                            if v ~= Player and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                                local EnemyPart = v.Character.HumanoidRootPart
                                local Distance = (Char.HumanoidRootPart.Position - EnemyPart.Position).Magnitude
                                
                                if Distance <= Range and v.Character.Humanoid.Health > 0 then
                                    -- Paksa "Sentuhan" Pedang ke Badan Musuh
                                    firetouchinterest(EnemyPart, WeaponPart, 0)
                                    task.wait(0.01)
                                    firetouchinterest(EnemyPart, WeaponPart, 1)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)
